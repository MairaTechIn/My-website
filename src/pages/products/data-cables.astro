---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Data Cables | Maira Tech Industry">

  <Navbar />

  <main class="mx-auto max-w-7xl px-6 py-24">

  <h1 class="text-5xl font-bold">
    Data & Charging Cables
  </h1>

  <p class="mt-6 max-w-3xl text-lg text-gray-600">
    Explore our complete range of charging and data cables designed for
    reliability, fast charging and OEM manufacturing.
  </p>

  <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3">

    <a
      href="/products/data-cables/standard-series"
      class="group rounded-3xl border border-gray-200 bg-white p-8 transition duration-300 hover:-translate-y-2 hover:shadow-xl"
    >
      <h2 class="text-2xl font-bold">
        Standard Series
      </h2>

      <p class="mt-3 text-gray-600">
        Everyday charging cables with dependable performance.
      </p>

      <p class="mt-8 text-3xl font-bold">
        From ₹25
      </p>

      <div class="mt-8 flex items-center justify-between">

        <span class="font-semibold">
          Explore
        </span>

        <span class="text-xl transition group-hover:translate-x-2">
          →
        </span>

      </div>

    </a>

    <a
      href="/products/data-cables/coffee-series"
      class="group rounded-3xl border border-gray-200 bg-white p-8 transition duration-300 hover:-translate-y-2 hover:shadow-xl"
    >
      <h2 class="text-2xl font-bold">
        Coffee Series
      </h2>

      <p class="mt-3 text-gray-600">
        Premium finish with reliable 4-core construction.
      </p>

      <p class="mt-8 text-3xl font-bold">
        From ₹52
      </p>

      <div class="mt-8 flex items-center justify-between">

        <span class="font-semibold">
          Explore
        </span>

        <span class="text-xl transition group-hover:translate-x-2">
          →
        </span>

      </div>

    </a>

    <a
      href="/products/data-cables/golf-series"
      class="group rounded-3xl border border-gray-200 bg-white p-8 transition duration-300 hover:-translate-y-2 hover:shadow-xl"
    >
      <h2 class="text-2xl font-bold">
        Golf Series
      </h2>

      <p class="mt-3 text-gray-600">
        Elegant design with enhanced durability.
      </p>

      <p class="mt-8 text-3xl font-bold">
        From ₹66
      </p>

      <div class="mt-8 flex items-center justify-between">

        <span class="font-semibold">
          Explore
        </span>

        <span class="text-xl transition group-hover:translate-x-2">
          →
        </span>

      </div>

    </a>

    <a
      href="/products/data-cables/golf-premium"
      class="group rounded-3xl border border-gray-200 bg-white p-8 transition duration-300 hover:-translate-y-2 hover:shadow-xl"
    >
      <h2 class="text-2xl font-bold">
        Golf Premium
      </h2>

      <p class="mt-3 text-gray-600">
        Premium USB-C cable series for high-performance charging.
      </p>

      <p class="mt-8 text-3xl font-bold">
        From ₹69
      </p>

      <div class="mt-8 flex items-center justify-between">

        <span class="font-semibold">
          Explore
        </span>

        <span class="text-xl transition group-hover:translate-x-2">
          →
        </span>

      </div>

    </a>

    <a
      href="/products/data-cables/braided-4-core"
      class="group rounded-3xl border border-gray-200 bg-white p-8 transition duration-300 hover:-translate-y-2 hover:shadow-xl"
    >
      <h2 class="text-2xl font-bold">
        Braided 4 Core
      </h2>

      <p class="mt-3 text-gray-600">
        Strong braided cables built for everyday durability.
      </p>

      <p class="mt-8 text-3xl font-bold">
        From ₹68
      </p>

      <div class="mt-8 flex items-center justify-between">

        <span class="font-semibold">
          Explore
        </span>

        <span class="text-xl transition group-hover:translate-x-2">
          →
        </span>

      </div>

    </a>

    <a
      href="/products/data-cables/braided-5-core"
      class="group rounded-3xl border border-gray-200 bg-white p-8 transition duration-300 hover:-translate-y-2 hover:shadow-xl"
    >
      <h2 class="text-2xl font-bold">
        Braided 5 Core
      </h2>

      <p class="mt-3 text-gray-600">
        Premium braided cables engineered for maximum performance.
      </p>

      <p class="mt-8 text-3xl font-bold">
        From ₹78
      </p>

      <div class="mt-8 flex items-center justify-between">

        <span class="font-semibold">
          Explore
        </span>

        <span class="text-xl transition group-hover:translate-x-2">
          →
        </span>

      </div>

    </a>

  </div>

</main>

  <Footer />

</Layout>