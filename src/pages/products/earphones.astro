---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Earphones | Maira Tech Industry">

  <Navbar />

  <main class="mx-auto max-w-6xl px-6 py-24">

    <h1 class="text-5xl font-bold">
      Wired/Wireless Earphones
    </h1>

    <p class="mt-6 max-w-2xl text-lg text-gray-600">
      Immersive sound with true wireless freedom.<br>

      Clear sound with dependable wired performance.
    </p>

    <div class="mt-20 rounded-3xl border border-dashed p-16 text-center">

      <h2 class="text-2xl font-semibold">
        Coming Soon
      </h2>

      <p class="mt-4 text-gray-500">
        We're preparing detailed product information for this category.
      </p>

    </div>

  </main>

  <Footer />

</Layout>