---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";

import CableSeriesPage from "../../../components/CableSeriesPage.astro";

import { cableSeries } from "../../../data/cableSeries";

const series = cableSeries.find(
  (item) => item.slug === "golf-premium"
);
---

<Layout title="Golf Premium Series | Maira Tech">

  <Navbar />

  <CableSeriesPage series={series} />

  <Footer />

</Layout>