---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Resources | Maira Tech Industry">

  <Navbar />

  <main class="bg-gray-50">

    <!-- Hero -->

    <section class="border-b bg-white">

      <div class="mx-auto max-w-6xl px-6 py-20">

        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-gray-500">
          Resources
        </p>

        <h1 class="mt-4 text-5xl font-bold">
          Downloads & Resources
        </h1>

        <p class="mt-6 max-w-3xl text-lg leading-8 text-gray-600">
          Access product catalogues, company brochures, warranty information
          and other useful documents from Maira Tech Industry.
        </p>

      </div>

    </section>



    <!-- Resource Cards -->

    <section class="mx-auto max-w-6xl px-6 py-20">

      <div class="grid gap-8 md:grid-cols-2">

        <!-- Catalogue -->

        <div class="rounded-3xl bg-white p-8 shadow-sm transition hover:-translate-y-2 hover:shadow-xl">

          <div class="text-5xl">📘</div>

          <h2 class="mt-6 text-2xl font-bold">
            Product Catalogue
          </h2>

          <p class="mt-3 text-gray-600">
            Browse our latest range of charging cables, chargers, power banks
            and electronic accessories.
          </p>

          <div class="mt-8 flex gap-4">

            <a
              href="#"
              class="rounded-xl bg-black px-6 py-3 text-white transition hover:bg-gray-800"
            >
              Coming Soon
            </a>

          </div>

        </div>



        <!-- Brochure -->

        <div class="rounded-3xl bg-white p-8 shadow-sm transition hover:-translate-y-2 hover:shadow-xl">

          <div class="text-5xl">🏢</div>

          <h2 class="mt-6 text-2xl font-bold">
            Company Brochure
          </h2>

          <p class="mt-3 text-gray-600">
            Learn more about Maira Tech Industry, our manufacturing capabilities,
            OEM services and quality standards.
          </p>

          <div class="mt-8">

            <a
              href="#"
              class="rounded-xl bg-black px-6 py-3 text-white transition hover:bg-gray-800"
            >
              Coming Soon
            </a>

          </div>

        </div>



        <!-- Warranty -->

        <div class="rounded-3xl bg-white p-8 shadow-sm transition hover:-translate-y-2 hover:shadow-xl">

          <div class="text-5xl">🛡️</div>

          <h2 class="mt-6 text-2xl font-bold">
            Warranty & Return Policy
          </h2>

          <p class="mt-3 text-gray-600">
            Read our warranty coverage, replacement policy and return process.
          </p>

          <div class="mt-8 flex gap-4">

            <a
              href="/resources/warranty"
              class="rounded-xl bg-black px-6 py-3 text-white transition hover:bg-gray-800"
            >
              Read Policy
            </a>

          </div>

        </div>



        <!-- OEM -->

        <div class="rounded-3xl bg-white p-8 shadow-sm transition hover:-translate-y-2 hover:shadow-xl">

          <div class="text-5xl">🏭</div>

          <h2 class="mt-6 text-2xl font-bold">
            OEM & Private Label
          </h2>

          <p class="mt-3 text-gray-600">
            Discover our custom branding, OEM manufacturing and private label
            solutions.
          </p>

          <div class="mt-8">

            <a
              href="#"
              class="rounded-xl bg-black px-6 py-3 text-white transition hover:bg-gray-800"
            >
              Coming Soon
            </a>

          </div>

        </div>

      </div>

    </section>

  </main>

  <Footer />

</Layout>