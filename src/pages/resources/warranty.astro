---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

import WarrantyContent from "../../content/policies/warranty.md";
---

<Layout title="Warranty & Return Policy | Maira Tech Industry">

  <Navbar />

  <main class="min-h-screen bg-gray-50">

    <!-- Hero -->

    <section class="border-b bg-white">

      <div class="mx-auto max-w-6xl px-6 py-20">

        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-gray-500">
          Support
        </p>

        <h1 class="mt-4 text-5xl font-bold">
          Warranty & Return Policy
        </h1>

        <p class="mt-6 max-w-3xl text-lg leading-8 text-gray-600">
          We stand behind the quality of every Maira Tech product.
          This page explains our warranty coverage, replacement process,
          return policy and customer responsibilities.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">

          <button
            id="download-pdf"
            class="rounded-xl bg-black px-8 py-4 font-semibold text-white transition hover:bg-gray-800"
          >
            Download PDF
          </button>

          <button
            type="button"
            class="open-contact-modal rounded-xl border border-gray-300 bg-white px-8 py-4 font-semibold text-black transition hover:bg-gray-100"
          >
            Contact Support
          </button>

        </div>

      </div>

    </section>



    <!-- Warranty Summary -->

    <section class="mx-auto mt-20 max-w-6xl px-6">

      <h2 class="text-3xl font-bold">
        Warranty Summary
      </h2>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">

        <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">

          <div class="text-3xl">🛡️</div>

          <h3 class="mt-5 text-xl font-semibold">
            6-Month Warranty
          </h3>

          <p class="mt-3 text-gray-600">
            Covers eligible manufacturing defects.
          </p>

        </div>

        <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">

          <div class="text-3xl">🔄</div>

          <h3 class="mt-5 text-xl font-semibold">
            Replacement
          </h3>

          <p class="mt-3 text-gray-600">
            Approved claims receive a replacement product.
          </p>

        </div>

        <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">

          <div class="text-3xl">📦</div>

          <h3 class="mt-5 text-xl font-semibold">
            Before Shipment
          </h3>

          <p class="mt-3 text-gray-600">
            Orders cancelled before dispatch are eligible for a refund.
          </p>

        </div>

        <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">

          <div class="text-3xl">❌</div>

          <h3 class="mt-5 text-xl font-semibold">
            No Refund
          </h3>

          <p class="mt-3 text-gray-600">
            Refunds are not available after shipment.
          </p>

        </div>

      </div>

    </section>



    <!-- Policy -->

    <section
      id="warranty-document"
      class="mx-auto my-24 max-w-7xl px-6"
    >

      <div class="rounded-3xl border border-gray-200 bg-white p-12 shadow-sm">

        <div class="mb-10 flex flex-col gap-3 border-b border-gray-200 pb-6 md:flex-row md:items-center md:justify-between">

          <h2 class="text-3xl font-bold">
            Policy Document
          </h2>

          <span class="text-sm text-gray-500">
            Last Updated: August 2026
          </span>

        </div>

        <article class="prose prose-lg prose-gray max-w-none">

          <WarrantyContent />

        </article>

      </div>

    </section>

  </main>

  <Footer />

</Layout>

<script type="module">
  import html2pdf from "html2pdf.js";

  const button = document.getElementById("download-pdf");

  button?.addEventListener("click", () => {

    const element = document.getElementById("warranty-document");

    if (!element) {
      console.error("Warranty document not found.");
      return;
    }

    html2pdf(element, {
      margin: 10,
      filename: "Maira-Tech-Warranty-Policy.pdf",
      image: {
        type: "jpeg",
        quality: 1
      },
      html2canvas: {
        scale: 2
      },
      jsPDF: {
        unit: "mm",
        format: "a4",
        orientation: "portrait"
      }
    });

  });
</script>