---
const { product } = Astro.props;
---

<a
  href={`/products/${product.id}`}
  class="group block rounded-3xl border border-gray-200 bg-white p-6 transition duration-300 hover:-translate-y-2 hover:shadow-xl"
>

  <img
    src={product.image}
    alt={product.name}
    class="mx-auto h-72 object-contain transition duration-300 group-hover:scale-105"
  />

  <p class="mt-6 text-sm font-semibold uppercase tracking-widest text-gray-500">
    {product.series}
  </p>

  <h2 class="mt-2 text-2xl font-bold">
    {product.name}
  </h2>

  <p class="mt-3 text-gray-600">
    {product.description}
  </p>

  <div class="mt-6 flex items-center justify-between">

    <div>

      <p class="text-sm text-gray-500">
        Starts From
      </p>

      <p class="text-2xl font-bold">
        ₹{product.startingPrice}
      </p>

    </div>

    <span class="text-xl transition group-hover:translate-x-2">
      →
    </span>

  </div>

</a>