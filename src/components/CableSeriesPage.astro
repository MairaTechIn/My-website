---
interface Color {
  name: string;
  value: string;
}

interface ChargingSpec {
  voltage: string;
  current: string;
  wattage: string;
  useCase: string;
}

interface Specification {
  property: string;
  value: string | ChargingSpec[];
}

interface Variant {
  id: string;
  name: string;
  connector: string;
  lengths: string[];
  colors: Color[];
  current: string;
  image: string;
  price: number;
}

interface Pricing {
  qty: string;
  price: number;
}

interface Series {
  slug: string;
  title: string;
  description: string;
  heroImage: string;
  startingPrice: number;
  variants: Variant[];
  pricing: Pricing[];
  specifications: Specification[];
}

const { series } = Astro.props as { series: Series };

const chargingSpecs =
  (series.specifications.find(
    (spec: Specification) => spec.property === "Charging Specs"
  )?.value as ChargingSpec[]) ?? [];
---
<main class="mx-auto max-w-7xl px-6 py-20">

  <!-- Hero -->

  <section class="grid items-center gap-16 lg:grid-cols-2">

    <div class="rounded-3xl bg-gray-100 p-10">

      <img
        src={series.heroImage}
        alt={series.title}
        class="mx-auto w-full max-w-xl"
      />

    </div>

    <div>

      <p class="text-sm uppercase tracking-[0.3em] text-gray-500">
        Data Cables
      </p>

      <h1 class="mt-4 text-5xl font-bold">
        {series.title}
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-8 text-gray-600">
        {series.description}
      </p>

      <p class="mt-8 text-sm uppercase tracking-wide text-gray-500">
        Starting From
      </p>

      <p class="text-3xl font-bold">
        ₹{series.startingPrice}
      </p>

      
    </div>

  </section>


<br><br><br><br><br>
  <!-- Variants -->

  <section class="mt-28">

    <h2 class="text-4xl font-bold">
      Available Variants
    </h2>

    <p class="mt-3 text-gray-600">
      Find the connector type best suited for your requirements.
    </p>

    <div class="mt-6 flex items-center justify-between">

      {
        series.variants.map((item: Variant) => (

          <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-2 hover:shadow-xl">

            <img
              src={item.image}
              alt={item.name}
              class="mx-auto h-72 object-contain transition duration-300 group-hover:scale-105"
            />

            <h3 class="mt-6 text-2xl font-bold">
              {item.name}
            </h3>

            <p class="mt-2 text-sm uppercase tracking-wide text-gray-500">
              Starting From
            </p>

            <p class="text-3xl font-bold">
              ₹{item.price}
            </p>

            <!-- Specification Chips -->

            <div class="mt-8 flex flex-wrap gap-3">

              <span class="rounded-full bg-gray-100 px-8 py-6 text-medium">
                🔌 {item.connector}
              </span>

              <span class="rounded-full bg-gray-100 px-8 py-6 text-medium">
                ⚡ {item.current}
              </span>

              {
                item.lengths.map((length: string) => (

                  <span class="rounded-full bg-gray-100 px-8 py-6 text-medium">

                    📏 {length}

                  </span>

                ))
              }

            </div>

            <!-- Colors -->

            <div class="mt-8">

              <p class="font-medium">
                Available Colors
              </p>

              <div class="mt-3 flex flex-wrap gap-5">

                {
                  item.colors.map((color: Color) => (

                    <div class="flex items-center gap-1">

                      <span
                        class="h-5 w-5 rounded-full border border-gray-300"
                        style={`background:${color.value};`}
                      ></span>

                      <span class="text-sm">
                        {color.name}
                      </span>

                    </div>

                  ))
                }

              </div>

            </div>

            
          </div>

        ))
      }

    </div>

  </section>


<br><br><br>
 <!-- Wholesale Pricing -->

<section class="mt-28">

  <h2 class="text-center text-4xl font-bold">
    Wholesale Pricing
  </h2>

  <p class="mt-3 text-center text-gray-600">
    Transparent pricing designed for retailers, distributors, and OEM partners.
  </p>

  <div class="mx-auto mt-12 grid max-w-5xl grid-cols-2 gap-6 lg:grid-cols-4">

    {
      series.pricing.map((row: Pricing) => (

        <div class="rounded-2xl border border-gray-200 bg-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">

          <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
            {row.qty} PCS
          </p>

          <div class="my-5 h-px bg-gray-100"></div>

          <p class="text-5xl font-bold tracking-tight text-gray-900">
            ₹{row.price}
          </p>

          <p class="mt-2 text-sm text-gray-500">
            Per Cable
          </p>

        </div>

      ))
    }

  </div>

  <p class="mt-8 text-center text-sm text-gray-500">
        Need more than <span class="font-semibold text-gray-900">200 pieces?</span><br>
        <a href="/contact" class="font-semibold text-black underline underline-offset-4 hover:text-gray-700">Contact us </a>
        for custom wholesale pricing.
  </p>

</section>

<br><br><br>

  

  <!-- Technical Specifications -->

<section class="mt-28">

  <h2 class="text-4xl font-bold text-center">
    Technical Specifications
  </h2>

  <p class="mt-3 text-center text-gray-600">
    Product specifications for the Standard Series.
  </p>

  <div class="mx-auto mt-12 max-w-5xl overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">

    <table class="w-full border-collapse">

      <thead>

        <!-- Table Title -->
        <tr class="bg-gray-50">
          <th colspan="4" class="border-b border-gray-200 py-6 text-center text-2xl font-semibold">
            Charging Specifications
          </th>
        </tr>

        <!-- Column Headers -->
        <tr class="bg-gray-50 text-sm uppercase tracking-wider text-gray-500">

          <th class="px-8 py-4 text-left font-semibold">
            Voltage
          </th>

          <th class="px-8 py-4 text-left font-semibold">
            Current
          </th>

          <th class="px-8 py-4 text-left font-semibold">
            Power
          </th>

          <th class="px-8 py-4 text-left font-semibold">
            Common Use Case
          </th>

        </tr>

      </thead>

      <tbody class="divide-y divide-gray-100">

        {chargingSpecs.map((item) => (

          <tr class="transition-colors duration-200 hover:bg-gray-50">

            <td class="px-8 py-6 text-lg font-semibold">
              {item.voltage}
            </td>

            <td class="px-8 py-6 text-gray-700">
              {item.current}
            </td>

            <td class="px-8 py-6 text-gray-700">
              {item.wattage}
            </td>

            <td class="px-8 py-6 text-gray-700">
              {item.useCase}
            </td>

          </tr>

        ))}

      </tbody>

    </table>

  </div>

</section>
<br><br><br><br><br><br><br><br><br><br>
</main>