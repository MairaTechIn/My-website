---
---
<dialog
  id="contactModal"
  class="backdrop:bg-black/60 rounded-3xl p-0 border-0 w-[95%] max-w-5xl"
>

  <div class="relative bg-white rounded-3xl overflow-hidden">

    <button
      onclick="document.getElementById('contactModal').close()"
      class="absolute right-5 top-5 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-white shadow hover:bg-gray-100"
    >
      ✕
    </button>

    <section class="bg-black px-8 py-16 text-center text-white md:px-12">

      <h2 class="text-4xl font-bold md:text-5xl">
        Ready to Work With Maira Tech?
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-300">
        Whether you need OEM manufacturing, bulk orders, or custom electronic
        solutions, our team is ready to help.
      </p>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

        <a
          href="tel:+919996783717"
          class="rounded-2xl bg-white p-6 text-center text-black transition duration-300 hover:-translate-y-1 hover:shadow-xl"
        >
          <img
            src="/images/sociallogos/call.png"
            alt="Phone"
            class="mx-auto h-10 w-10 object-contain"
          />

          <h3 class="mt-3 text-lg font-semibold">
            Call Now
          </h3>

          <p class="mt-2 text-sm text-gray-600">
            +91 99967 83717
          </p>
        </a>




        <!-- WhatsApp -->
        <a
          href="https://wa.me/919996783717"
          target="_blank"
          class="rounded-2xl bg-white p-6 text-center text-black transition duration-300 hover:-translate-y-1 hover:shadow-xl"
        >
          <img
           src="/images/sociallogos/whatsapp.png"
           alt="WhatsApp"
           class="mx-auto h-10 w-10 object-contain"
          />

          <h3 class="mt-3 text-lg font-semibold">
            WhatsApp
          </h3>

          <p class="mt-2 text-sm text-gray-600">
            +91 99967 83717
          </p>
        </a>
        
        <a
          href="https://maps.app.goo.gl/tHbfFRUH59G1iYJZA"
          target="_blank"
          class="rounded-2xl bg-white p-6 text-center text-black transition duration-300 hover:-translate-y-1 hover:shadow-xl"
        >
          <img
            src="/images/sociallogos/maps.png"
            alt="Location"
            class="mx-auto h-10 w-10 object-contain"
          />

          <h3 class="mt-3 text-lg font-semibold">
            Factory Location
          </h3>

          <p class="mt-2 text-sm text-gray-600">
            Open in Google Maps
          </p>
        </a>
        <!-- Instagram -->
        <a
          href="https://instagram.com/mairatechindustry"
          target="_blank"
          class="rounded-2xl bg-white p-6 text-center text-black transition duration-300 hover:-translate-y-1 hover:shadow-xl"
        >
          <img
           src="/images/sociallogos/instagram.png"
           alt="Instagram"
           class="mx-auto h-10 w-10 object-contain"
          />

          <h3 class="mt-3 text-lg font-semibold">
            Instagram
          </h3>

          <p class="mt-2 text-sm text-gray-600">
            @mairatechindustry
          </p>
        </a>

        <!-- Facebook -->
        <a
          href="https://www.facebook.com/share/1Bf3iYRNWa/"
          target="_blank"
          class="rounded-2xl bg-white p-6 text-center text-black transition duration-300 hover:-translate-y-1 hover:shadow-xl"
        >
          <img
           src="/images/sociallogos/facebook.png"
           alt="Facebook"
           class="mx-auto h-10 w-10 object-contain"
          />

          <h3 class="mt-3 text-lg font-semibold">
            Facebook
          </h3>

          <p class="mt-2 text-sm text-gray-600">
            Follow Our Page
          </p>
        </a>

        <!-- Email -->
        <a
          href="mailto:mairatechindustry@gmail.com"
          class="rounded-2xl bg-white p-6 text-center text-black transition duration-300 hover:-translate-y-1 hover:shadow-xl"
        >
          <img
           src="/images/sociallogos/email.png"
           alt="Email"
           class="mx-auto h-10 w-10 object-contain"
          />

          <h3 class="mt-3 text-lg font-semibold">
            Email
          </h3>

          <p class="mt-2 text-sm text-gray-600 break-all">
            mairatechindustry@gmail.com
          </p>
        </a>


      </div>

    </section>

  </div>

</dialog>

<script>
  const dialog = document.getElementById("contactModal") as HTMLDialogElement;

  function openContactModal() {
    dialog.showModal();
  }

  function closeContactModal() {
    dialog.close();
  }

  document.addEventListener("click", (e) => {
    const target = e.target;

    if (
      target instanceof HTMLElement &&
      target.closest(".open-contact-modal")
    ) {
      openContactModal();
    }
  });
</script>