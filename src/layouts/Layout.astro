---
import "../styles/global.css";

interface Props {
  title?: string;
}

const {
  title = "Maira Tech Industry | Premium Electronic Accessories Manufacturer"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8" />

<meta
name="viewport"
content="width=device-width, initial-scale=1.0" />

<title>{title}</title>

<meta
name="description"
content="Maira Tech Industry manufactures premium electronic accessories, chargers, cables and OEM solutions." />

<link rel="icon" href="/goldenfavicon.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<link
href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap"
rel="stylesheet" />

</head>

<body>

<slot />

</body>

</html>